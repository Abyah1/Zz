<section class="relative text-center py-20 bg-gradient-to-b from-[#0a0a0a] to-black">
  <h1 class="text-4xl font-bold text-white mb-4">مرحباً بك في {{ shop.name }}</h1>
  <p class="text-gray-400 mb-8">اكتشف منتجاتنا الفاخرة بتصميم عصري أنيق</p>
  <a href="/collections/all" class="btn">تصفح المتجر</a>
</section>

<section class="py-12 px-6">
  <h2 class="text-2xl font-bold mb-6 border-b border-gray-700 pb-2">منتجات مختارة</h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    {% for product in collections.frontpage.products %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
</section>
